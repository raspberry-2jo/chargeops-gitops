{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "chargeops-ws-policy-v1",
  "title": "ChargeOps · WebSocket Canary 판정 v1",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "chargeops",
    "canary",
    "experimental"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "검사 결과를 읽는 방법",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**1=통과 · 0=미검증/보류 · -1=실패**. 현재 선택한 후보·단계의 새 검사만 표시합니다. 오래된 결과는 현재 상태로 표시하지 않습니다. 아래 판정은 서버 관점이며 클라이언트 재연결 p95는 계측 전입니다. Basic Canary의 25/50/100%는 Pod 비율이며 실제 WebSocket 트래픽 비율이 아닙니다."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "배포 단계별 검사 판정 · 미수집은 빈 구간",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "chargeops_ws_canary_state{candidate=~\"$candidate\",stage=~\"$stage\"} and on(candidate,stage) (time() - chargeops_ws_canary_observed_timestamp_seconds{candidate=~\"$candidate\",stage=~\"$stage\"} < 15)",
          "refId": "A",
          "legendFormat": "{{candidate}} / {{stage}}%",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "실패",
                  "color": "red"
                },
                "0": {
                  "text": "보류",
                  "color": "gray"
                },
                "1": {
                  "text": "통과",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "연결 감소율 · 안정 1분 >2% 실패",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "chargeops_ws_canary_signal_value{candidate=~\"$candidate\",stage=~\"$stage\",signal=\"connections\"} and on(candidate,stage) (time() - chargeops_ws_canary_observed_timestamp_seconds{candidate=~\"$candidate\",stage=~\"$stage\"} < 15)",
          "refId": "A",
          "legendFormat": "{{signal}} / {{candidate}} / {{stage}}%",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "chargeops_ws_canary_signal_limit{candidate=~\"$candidate\",stage=~\"$stage\",signal=\"connections\"} and on(candidate,stage) (time() - chargeops_ws_canary_observed_timestamp_seconds{candidate=~\"$candidate\",stage=~\"$stage\"} < 15)",
          "refId": "B",
          "legendFormat": "실패 경계",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "실패 경계"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      }
    },
