[
  {
    "file": "ChargeOps_4차_①실험중_대시보드.json",
    "queries": [
      "sum(kube_pod_status_ready{namespace=\"$namespace\",pod=~\"$pod_regex\",condition=\"true\"}) < 4",
      "sum(max by (pod) (chargeops_csms_connections{namespace=\"$namespace\"} or chargeops_csms_connections{exported_namespace=\"$namespace\"}))",
      "sum(kube_pod_status_ready{namespace=\"$namespace\",pod=~\"$pod_regex\",condition=\"true\"})",
      "histogram_quantile(0.95, sum by (le) (rate(chargeops_ocpp_handle_seconds_bucket[1m])))",
      "100 * sum(rate(chargeops_ocpp_handler_results_total{result=~\"error|timeout\"}[1m])) / sum(rate(chargeops_ocpp_handler_results_total[1m])) or vector(0)",
      "sum(pg_stat_activity_count{datname=\"chargeops\",state=~\"idle in transaction.*\"}) or vector(0)",
      "count(ALERTS{alertstate=\"firing\",alertname!~\"Watchdog|InfoInhibitor\"}) or vector(0)",
      "max by (pod) (chargeops_csms_connections{namespace=\"$namespace\"} or chargeops_csms_connections{exported_namespace=\"$namespace\"})",
      "histogram_quantile(0.95, sum by (le) (rate(chargeops_ocpp_handle_seconds_bucket[1m]))) * 1000",
      "label_replace(label_replace(100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"10.10.20.(21|22):.*\"}[1m])) * 100,\"instance\",\"k8s-w01\",\"instance\",\"10.10.20.21:.*\"),\"instance\",\"k8s-w02\",\"instance\",\"10.10.20.22:.*\")",
      "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"db-0[12]\"}[1m])) * 100",
      "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=\"loadgen\"}[1m])) * 100",
      "sum by (state) (pg_stat_activity_count{datname=\"chargeops\"})"
    ]
  },
  {
    "file": "ChargeOps_4차_②끝난뒤조회_대시보드.json",
    "queries": [
      "sum(kube_pod_status_ready{namespace=\"$namespace\",pod=~\"$pod_regex\",condition=\"true\"}) < 4",
      "sum(rate(chargeops_ocpp_messages_total[1m]))",
      "sum(max by (pod) (chargeops_csms_connections{namespace=\"$namespace\"} or chargeops_csms_connections{exported_namespace=\"$namespace\"})) / 20",
      "label_replace(label_replace(100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"10.10.20.(21|22):.*\"}[1m])) * 100,\"instance\",\"k8s-w01\",\"instance\",\"10.10.20.21:.*\"),\"instance\",\"k8s-w02\",\"instance\",\"10.10.20.22:.*\")",
      "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"db-0[12]\"}[1m])) * 100",
      "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=\"loadgen\"}[1m])) * 100",
      "histogram_quantile(0.95, sum by (le) (rate(chargeops_ocpp_handle_seconds_bucket[1m])))",
      "sum(rate(chargeops_ocpp_handle_seconds_sum[1m])) / sum(rate(chargeops_ocpp_handle_seconds_count[1m]))",
      "sum by (reason) (rate(chargeops_csms_disconnect_total[1m]))",
      "sum(rate(chargeops_csms_reconnect_total[1m]))",
      "sum(rate(pg_stat_database_xact_commit{datname=\"chargeops\"}[1m]))",
      "sum(rate(pg_stat_database_xact_rollback{datname=\"chargeops\"}[1m]))",
      "max(rate(pg_stat_replication_pg_current_wal_lsn_bytes[5m]))",
      "max(pg_stat_replication_pg_wal_lsn_diff)",
      "count by (alertname) (ALERTS{alertstate=\"firing\"})",
      "count by (node) (kube_pod_info{namespace=\"$namespace\",pod=~\"$pod_regex\"} * on(namespace,pod) group_left() (kube_pod_status_ready{namespace=\"$namespace\",pod=~\"$pod_regex\",condition=\"true\"} == 1))",
      "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"$pod_regex\",container!=\"\",container!=\"POD\"}[2m]))",
      "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"$pod_regex\",container!=\"\",container!=\"POD\"})",
      "100 * sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\",pod=~\"$pod_regex\",container!=\"\",container!=\"POD\"}[5m])) / clamp_min(sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"$namespace\",pod=~\"$pod_regex\",container!=\"\",container!=\"POD\"}[5m])), 0.001)",
      "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100",
      "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
      "avg_over_time((100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)[$__range:1m])",
      "max_over_time((100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)[$__range:1m])",
      "avg_over_time((100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))[$__range:1m])",
      "max_over_time((100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))[$__range:1m])"
    ]
  },
  {
    "file": "ChargeOps_5차_HPA시험_촬영용_대시보드.json",
    "queries": [
      "sum(max by (pod) (chargeops_csms_connections{namespace=\"$namespace\"} or chargeops_csms_connections{exported_namespace=\"$namespace\"}))",
      "sum(kube_pod_status_ready{namespace=\"$namespace\",pod=~\"$pod_regex\",condition=\"true\"})",
      "100 * sum(rate(chargeops_ocpp_handler_results_total{result=~\"error|timeout\"}[1m])) / sum(rate(chargeops_ocpp_handler_results_total[1m])) or vector(0)",
      "max(label_replace(label_replace(100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"10.10.20.(21|22):.*\"}[1m])) * 100,\"instance\",\"k8s-w01\",\"instance\",\"10.10.20.21:.*\"),\"instance\",\"k8s-w02\",\"instance\",\"10.10.20.22:.*\"))",
      "max by (pod) (chargeops_csms_connections{namespace=\"$namespace\"} or chargeops_csms_connections{exported_namespace=\"$namespace\"})",
      "sum(rate(chargeops_csms_disconnect_total[1m]))",
      "sum(rate(chargeops_csms_reconnect_total[1m]))",
      "histogram_quantile(0.95, sum by (le) (rate(chargeops_ocpp_handle_seconds_bucket[1m]))) * 1000"
    ]
  }
]