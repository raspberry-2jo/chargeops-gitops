      "targets": [
        {
          "expr": "chargeops_ws_canary_signal_value{namespace=\"dev\",candidate=~\"$candidate\",stage=~\"$stage\",signal=\"connections\"} and on(candidate,stage) (time() - chargeops_ws_canary_observed_timestamp_seconds{namespace=\"dev\",candidate=~\"$candidate\",stage=~\"$stage\"} < 15)",
          "refId": "A",
          "legendFormat": "{{signal}} / {{candidate}} / {{stage}}%",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "chargeops_ws_canary_signal_limit{namespace=\"dev\",candidate=~\"$candidate\",stage=~\"$stage\",signal=\"connections\"} and on(candidate,stage) (time() - chargeops_ws_canary_observed_timestamp_seconds{namespace=\"dev\",candidate=~\"$candidate\",stage=~\"$stage\"} < 15)",
          "refId": "B",
          "legendFormat": "실패 경계",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "실패 경계"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
